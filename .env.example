# Public canonical URL used for metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional overrides. The checked-in defaults are public Supabase client credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-only secret used to HMAC request IPs for privacy-preserving rate limiting.
WAITLIST_RATE_LIMIT_SECRET=generate-a-random-32-byte-secret
